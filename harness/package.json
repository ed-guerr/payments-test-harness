{
  "name": "payments-test-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime JSON test harness for the payments backend — Electron GUI + headless CLI + MCP server",
  "type": "commonjs",
  "main": "dist/main/main/main.js",
  "scripts": {
    "gen:registry": "node scripts/gen_registry.js",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.js",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && HARNESS_SELF_TEST=1 electron .",
    "run:cli": "tsx src/runner/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^44.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
