{
  "name": "payments-test-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime JSON test harness for the payments backend — Electron GUI + headless CLI + MCP server",
  "type": "commonjs",
  "main": "dist/main/main/main.js",
  "scripts": {
    "gen:registry": "node scripts/gen_registry.js",
    "kb": "tsx src/kb/cli.ts",
    "kb:check": "tsx src/kb/cli.ts check",
    "kb:write": "tsx src/kb/cli.ts write",
    "kb:search": "tsx src/kb/cli.ts search",
    "design": "tsx src/design/cli.ts",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.js",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && HARNESS_SELF_TEST=1 electron .",
    "run:cli": "tsx src/runner/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "eval": "tsx src/eval/cli.ts",
    "eval:smoke": "tsx src/eval/cli.ts --smoke",
    "eval:replay": "tsx src/eval/replay.ts",
    "test:unit": "tsx --test src/protocol/codec.test.ts src/runner/matchAck.test.ts src/runner/report.test.ts src/eval/report.test.ts src/eval/agent.test.ts src/eval/ablation.test.ts src/eval/cli.test.ts src/eval/manifest.test.ts src/kb/kb.test.ts src/backend/suites.test.ts src/db/db.test.ts",
    "test:mcp": "node scripts/mcp-self-test.js",
    "verify": "sh scripts/verify.sh",
    "typecheck": "tsc --noEmit",
    "bench": "tsx src/bench.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^44.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
