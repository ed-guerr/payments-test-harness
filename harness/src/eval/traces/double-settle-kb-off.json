    },
    {
      "tool": "create_suite",
      "args": {
        "name": "eval-double-settle-rejection",
        "steps": [
          {
            "id": "create",
            "send": {
              "to": "pay-orders",
              "msg": "CreatePayment",
              "fields": {
                "txn_id": 3001,
                "account": "ACCT-001",
                "amount_cents": 50000,
                "currency": "USD"
              }
            },
            "expectAck": {
              "status": 0
            }
          },
          {
            "id": "transfer",
            "send": {
              "to": "ledger",
              "msg": "TransferFunds",
              "fields": {
                "txn_id": 3001,
                "from_acct": "ACCT-001",
                "to_acct": "ACCT-002",
                "amount_cents": 50000
              }
            },
            "expectAck": {
              "status": 0,
              "from_balance_after": 450000
            }
          },
          {
            "id": "authorize",
            "send": {
              "to": "auth-gateway",
              "msg": "Authorize",
              "fields": {
                "txn_id": 3001,
                "amount_cents": 50000
              }
            },
            "expectAck": {
              "approved": 1,
              "auth_code": "AU-0003001"
            }
          },
          {
            "id": "wait-complete",
            "delayMs": 300
          },
          {
            "id": "assert-complete",
            "dbAssert": {
              "sql": "SELECT status FROM payments WHERE txn_id = ?",
              "params": [
                3001
              ],
              "expect": {
                "status": "complete"
              }
            }
          },
          {
            "id": "settle-first",
            "send": {
              "to": "auth-gateway",
              "msg": "Settle",
              "fields": {
                "txn_id": 3001,
                "fee_cents": 2500
              }
            },
            "expectAck": {
              "status": 0,
              "settled_cents": 50000
            }
          },
          {
            "id": "wait-settle",
            "delayMs": 300
          },
          {
            "id": "assert-settled",
            "dbAssert": {
              "sql": "SELECT status FROM payments WHERE txn_id = ?",
              "params": [
                3001
              ],
              "expect": {
                "status": "settled"
              }
            }
          },
          {
            "id": "assert-reserve-after-first",
            "dbAssert": {
              "sql": "SELECT balance_cents FROM accounts WHERE acct = ?",
              "params": [
                "RESERVE"
              ],
              "expect": {
                "balance_cents": 1050000
              }
            }
          },
          {
            "id": "settle-second",
            "send": {
              "to": "auth-gateway",
              "msg": "Settle",
              "fields": {
                "txn_id": 3001,
                "fee_cents": 2500
              }
            },
            "expectAck": {
              "status": 2
            }
          },
          {
            "id": "assert-still-settled",
            "dbAssert": {
              "sql": "SELECT status FROM payments WHERE txn_id = ?",
              "params": [
                3001
              ],
              "expect": {
                "status": "settled"
              }
            }
          },
          {
            "id": "assert-reserve-unchanged",
            "dbAssert": {
              "sql": "SELECT balance_cents FROM accounts WHERE acct = ?",
              "params": [
                "RESERVE"
              ],
              "expect": {
                "balance_cents": 1050000
              }
            }
          },
          {
            "id": "assert-no-extra-postings",
            "dbAssert": {
              "sql": "SELECT COUNT(*) AS n FROM ledger_entries WHERE txn_id = ? AND status = 'applied'",
              "params": [
                3001
              ],
              "expect": {
                "n": 2
              }
            }
          }
        ],
        "description": "A payment can only be settled once: create+transfer+authorize a 50000-cent payment on ACCT-001, settle it (RESERVE +50000), then attempt a second Settle which must be rejected (ack status 2) with no extra money moving into RESERVE and no extra applied ledger postings."
      },
      "expect": {
        "ok": true,
        "contains": [
          "created"
        ]
      }
    },
