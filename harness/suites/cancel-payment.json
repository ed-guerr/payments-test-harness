{
  "name": "cancel-payment",
  "description": "Cancel an open payment; it can no longer be authorized; no money moved",
  "steps": [
    {
      "id": "create",
      "send": { "to": "pay-orders", "msg": "CreatePayment", "fields": { "txn_id": 1003, "account": "ACCT-002", "amount_cents": 1000, "currency": "USD" } },
      "expectAck": { "status": 0 }
    },
    {
      "id": "cancel",
      "send": { "to": "pay-orders", "msg": "CancelPayment", "fields": { "txn_id": 1003, "reason": "test" } },
      "expectAck": { "status": 0 }
    },
    {
      "id": "assert-cancelled",
      "dbAssert": { "sql": "SELECT status FROM payments WHERE txn_id = ?", "params": [1003], "expect": { "status": "cancelled" } }
    },
    {
      "id": "assert-balance-unchanged",
      "dbAssert": { "sql": "SELECT balance_cents FROM accounts WHERE acct = ?", "params": ["ACCT-002"], "expect": { "balance_cents": 250000 } }
    },
    {
      "id": "authorize-refused",
      "send": { "to": "auth-gateway", "msg": "Authorize", "fields": { "txn_id": 1003, "amount_cents": 1000 } },
      "expectAck": { "approved": 0 }
    }
  ]
}
