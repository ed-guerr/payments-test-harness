{
  "name": "no-double-settle",
  "description": "A payment can only be settled once: second Settle returns ack status 2 (already settled) and moves no funds",
  "steps": [
    {
      "id": "create",
      "send": {
        "to": "pay-orders",
        "msg": "CreatePayment",
        "fields": {
          "txn_id": 2001,
          "account": "ACCT-001",
          "amount_cents": 50000,
          "currency": "USD"
        }
      },
      "expectAck": {
        "status": 0
      }
    },
    {
      "id": "authorize",
      "send": {
        "to": "auth-gateway",
        "msg": "Authorize",
        "fields": {
          "txn_id": 2001,
          "amount_cents": 50000
        }
      },
      "expectAck": {
        "approved": 1,
        "auth_code": "AU-0002001"
      }
    },
    {
      "id": "wait-complete",
      "delayMs": 300
    },
    {
      "id": "settle-first",
      "send": {
        "to": "auth-gateway",
        "msg": "Settle",
        "fields": {
          "txn_id": 2001,
          "fee_cents": 2500
        }
      },
      "expectAck": {
        "status": 0,
        "settled_cents": 50000
      }
    },
    {
      "id": "wait-settle",
      "delayMs": 300
    },
    {
      "id": "assert-settled",
      "dbAssert": {
        "sql": "SELECT status FROM payments WHERE txn_id = ?",
        "params": [
          2001
        ],
        "expect": {
          "status": "settled"
        }
      }
    },
    {
      "id": "assert-reserve-after-first",
      "dbAssert": {
        "sql": "SELECT balance_cents FROM accounts WHERE acct = ?",
        "params": [
          "RESERVE"
        ],
        "expect": {
          "balance_cents": 1050000
        }
      }
    },
    {
      "id": "settle-second",
      "send": {
        "to": "auth-gateway",
        "msg": "Settle",
        "fields": {
          "txn_id": 2001,
          "fee_cents": 2500
        }
      },
      "expectAck": {
        "status": 2
      }
    },
    {
      "id": "assert-still-settled",
      "dbAssert": {
        "sql": "SELECT status FROM payments WHERE txn_id = ?",
        "params": [
          2001
        ],
        "expect": {
          "status": "settled"
        }
      }
    },
    {
      "id": "assert-reserve-unchanged",
      "dbAssert": {
        "sql": "SELECT balance_cents FROM accounts WHERE acct = ?",
        "params": [
          "RESERVE"
        ],
        "expect": {
          "balance_cents": 1050000
        }
      }
    }
  ]
}
