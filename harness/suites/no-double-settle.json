{
  "name": "no-double-settle",
  "description": "Settle a completed payment, then attempt a second Settle: it must be rejected (ST_SETTLED=2) and no additional funds may move",
  "steps": [
    {
      "id": "create",
      "send": {
        "to": "pay-orders",
        "msg": "CreatePayment",
        "fields": {
          "txn_id": 2001,
          "account": "ACCT-001",
          "amount_cents": 50000,
          "currency": "USD"
        }
      },
      "expectAck": {
        "status": 0
      }
    },
    {
      "id": "authorize",
      "send": {
        "to": "auth-gateway",
        "msg": "Authorize",
        "fields": {
          "txn_id": 2001,
          "amount_cents": 50000
        }
      },
      "expectAck": {
        "approved": 1
      }
    },
    {
      "id": "wait-complete-forward",
      "delayMs": 300
    },
    {
      "id": "settle-first",
      "send": {
        "to": "auth-gateway",
        "msg": "Settle",
        "fields": {
          "txn_id": 2001,
          "fee_cents": 2500
        }
      },
      "expectAck": {
        "status": 0,
        "settled_cents": 50000
      }
    },
    {
      "id": "wait-settle-forward",
      "delayMs": 300
    },
    {
      "id": "settle-second",
      "send": {
        "to": "auth-gateway",
        "msg": "Settle",
        "fields": {
          "txn_id": 2001,
          "fee_cents": 2500
        }
      },
      "expectAck": {
        "status": 2
      }
    },
    {
      "id": "assert-status-still-settled",
      "dbAssert": {
        "sql": "SELECT status FROM payments WHERE txn_id = ?",
        "params": [
          2001
        ],
        "expect": {
          "status": "settled"
        }
      }
    },
    {
      "id": "assert-payer-debited-once",
      "dbAssert": {
        "sql": "SELECT balance_cents FROM accounts WHERE acct = ?",
        "params": [
          "ACCT-001"
        ],
        "expect": {
          "balance_cents": 450000
        }
      }
    },
    {
      "id": "assert-reserve-credited-once",
      "dbAssert": {
        "sql": "SELECT balance_cents FROM accounts WHERE acct = ?",
        "params": [
          "RESERVE"
        ],
        "expect": {
          "balance_cents": 1050000
        }
      }
    }
  ]
}
